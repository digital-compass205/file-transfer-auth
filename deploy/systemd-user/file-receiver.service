[Unit]
Description=File-receiver service (mTLS upload endpoint)
After=network.target

[Service]
# See ca-service.service / README "Using a non-default Java" for how to
# override JAVA_BIN without editing this file.
Environment=JAVA_BIN=/usr/bin/java
EnvironmentFile=-%h/file-transfer/java.env
ExecStart=/bin/sh -c 'exec "${JAVA_BIN}" -jar %h/file-transfer/file-receiver/file-receiver.jar %h/file-transfer/file-receiver/receiver.properties'
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=%h/file-transfer/file-receiver %h/file-transfer/logs
# Denies this process filesystem access to the CA's private key material,
# even though ca-service and file-receiver share the same account: it stops
# accidents and most bugs in this service from ever touching that data.
ReadOnlyPaths=%h/file-transfer/pki/certs %h/file-transfer/pki/crl

[Install]
WantedBy=default.target
